{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": [
    "src/index.ts",
    "src/schema/**/*.ts",
    "src/env-contract/**/*.ts",
    "src/event-contracts/**/*.ts",
    "src/error/**/*.ts",
    "src/i18n-contract/**/*.ts",
    "src/glossary-contract/**/*.ts",
    "src/calculator-engine/**/*.ts",
    "src/internal/record.ts"
  ],
  "exclude": ["scripts/**", "tests/**", "dist/**", "src/libs-contracts/**"]
}
