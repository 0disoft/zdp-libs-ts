{
  "name": "zdp-libs-ts",
  "version": "0.17.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "ZDP TypeScript contract libraries and jurisdiction-neutral calculator engine.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/zdp-libs-ts.git"
  },
  "bugs": {
    "url": "https://github.com/0disoft/zdp-libs-ts/issues"
  },
  "homepage": "https://github.com/0disoft/zdp-libs-ts#readme",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./env-contract": {
      "types": "./dist/env-contract/index.d.ts",
      "import": "./dist/env-contract/index.js",
      "default": "./dist/env-contract/index.js"
    },
    "./event-contracts": {
      "types": "./dist/event-contracts/index.d.ts",
      "import": "./dist/event-contracts/index.js",
      "default": "./dist/event-contracts/index.js"
    },
    "./error": {
      "types": "./dist/error/index.d.ts",
      "import": "./dist/error/index.js",
      "default": "./dist/error/index.js"
    },
    "./i18n-contract": {
      "types": "./dist/i18n-contract/index.d.ts",
      "import": "./dist/i18n-contract/index.js",
      "default": "./dist/i18n-contract/index.js"
    },
    "./glossary-contract": {
      "types": "./dist/glossary-contract/index.d.ts",
      "import": "./dist/glossary-contract/index.js",
      "default": "./dist/glossary-contract/index.js"
    },
    "./calculator-engine": {
      "types": "./dist/calculator-engine/index.d.ts",
      "import": "./dist/calculator-engine/index.js",
      "default": "./dist/calculator-engine/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/schema/",
    "dist/env-contract/",
    "dist/event-contracts/",
    "dist/error/",
    "dist/i18n-contract/",
    "dist/glossary-contract/",
    "dist/calculator-engine/",
    "dist/internal/record.js",
    "dist/internal/record.js.map",
    "dist/internal/record.d.ts",
    "dist/internal/record.d.ts.map",
    "contracts/",
    "glossary/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "BOUNDARY.md",
    "RUNBOOK.md",
    "service.yaml",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun scripts/build-package.ts",
    "build:emit": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && bun test && bun run contracts:check",
    "check:integration": "bun run calculator-catalog:check && bun run contracts:check:integration && bun run test:integration",
    "check:tsgo": "tsgo --noEmit",
    "test": "bun test",
    "test:integration": "bun scripts/test-api-contract-integration.ts --api-contracts-root ../zdp-api-contracts",
    "contracts:check": "bun scripts/check-libs-contracts.ts",
    "contracts:check:integration": "bun scripts/check-libs-contracts.ts --api-contracts-root ../zdp-api-contracts",
    "calculator-catalog:generate": "bun scripts/generate-calculator-catalog.ts --api-contracts-root ../zdp-api-contracts",
    "calculator-catalog:check": "bun scripts/generate-calculator-catalog.ts --check --api-contracts-root ../zdp-api-contracts",
    "package:check": "bun run build && bun scripts/check-packed-package.ts",
    "prepack": "bun run build",
    "release:verify": "bun run check && bun run check:integration && bun run build && bun scripts/check-packed-package.ts && bun scripts/smoke-packed-package.ts",
    "smoke:package": "bun run build && bun scripts/smoke-packed-package.ts",
    "smoke:published": "bun scripts/smoke-published-package.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260603.1",
    "typescript": "^6.0.3"
  }
}
